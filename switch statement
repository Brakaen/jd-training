let mark = 85;
switch (true) {
    case (mark >= 90):
        console.log("Grade: A");
        break;
    case (mark >= 80):
        console.log("Grade: B");
        break;
    case (mark >= 70):
        console.log("Grade: C");
        break;
    case (mark >= 60):
        console.log("Grade: D");
        break;
    default:
        console.log("Grade: F");
}
let day = "Monday";
switch (day) {
    case "Monday":
        console.log("Start of the work week");
        break;
    case "Tuesday":
        console.log("Second day of the work week");
        break;
    case "Wednesday":
        console.log("Midweek");
        break;
    case "Thursday":
        console.log("Almost the weekend");
        break;
    case "Friday":
        console.log("Last day of the work week");
        break;
    case "Saturday":
    case "Sunday":
        console.log("Weekend!");
        break;
    default:
        console.log("Invalid day");
}